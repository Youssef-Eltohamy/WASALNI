# ===========================================
# WASALNI - Environment Variables (Example)
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ----- Supabase (Public) -----
# Used by both mobile app and admin dashboard
SUPABASE_URL=https://nseuurovkxymrwxamftz.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ----- Supabase (Server-only, for admin tasks) -----
# DO NOT expose this in the mobile app or client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- Next.js Admin (apps/admin) -----
NEXT_PUBLIC_SUPABASE_URL=https://nseuurovkxymrwxamftz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
